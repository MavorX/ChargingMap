# 复制此文件为 .env.local 并填入你自己的密钥(高德开放平台 https://lbs.amap.com/ 申请)
VITE_AMAP_KEY=your_amap_key_here
VITE_AMAP_SECURITY_CODE=your_amap_security_code_here

# 演示数据开关（默认关闭）：false = 空态首启；true = 载入 src/mocks/userDemo.js 演示数据
VITE_DEMO=false


# 部署子路径（默认 /）：GitHub Pages 等项目站点填 /ChargingMap/
# 必须以 / 开头，构建前由 scripts/prebuild-check.mjs 校验
VITE_BASE=/
