{
  "name": "vwer-charging",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prebuild-check.mjs && vite build",
    "build:analyze": "node scripts/prebuild-check.mjs && vite build --mode analyze",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "check:deps": "npm audit --registry=https://registry.npmjs.org",
    "check:data": "node scripts/validate-data.mjs",
    "check:a11y": "node scripts/check-a11y.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{vue,js}\" \"e2e/**/*.js\" playwright.config.js scripts/browser-test-server.mjs scripts/capture-presentation.mjs",
    "format:check": "prettier --check \"src/**/*.{vue,js}\" \"e2e/**/*.js\" playwright.config.js scripts/browser-test-server.mjs scripts/capture-presentation.mjs"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.44",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
