{
  "name": "vwer-charging",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prebuild-check.mjs && vite build",
    "build:analyze": "node scripts/prebuild-check.mjs && vite build --mode analyze",
    "preview": "vite preview",
    "test": "vitest",
    "check:data": "node scripts/validate-data.mjs",
    "check:a11y": "node scripts/check-a11y.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{vue,js}\"",
    "format:check": "prettier --check \"src/**/*.{vue,js}\""
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.44",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.9",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^3.4.19",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
